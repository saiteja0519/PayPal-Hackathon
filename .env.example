# ──────────────────────────────────────────────
# PayPilot AI – Backend Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./paypilot.db

# Security – CHANGE THIS in production!
SECRET_KEY=paypilot_super_secret_dev_key_change_in_production_9988776655
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PayPal (leave as mock_ for demo mode)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=mock_paypal_client_id
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret
PAYPAL_WEBHOOK_ID=

# AI Provider ('deterministic' works without API keys)
AI_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=billing@paypilot.ai

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo data seeding
SEED_DEMO_DATA=true
