# PayPilot AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to Git.

# ──────────────────────────────────────────────
# Backend (FastAPI)
# ──────────────────────────────────────────────

# Secret key used to sign JWTs — generate with: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_long_random_secret_key

# JWT token expiry in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite database file path (development default)
DATABASE_URL=sqlite:///./paypilot.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paypilot

# ──────────────────────────────────────────────
# PayPal Sandbox credentials
# Get from: https://developer.paypal.com/dashboard/
# ──────────────────────────────────────────────

# Set to "sandbox" for development, "live" for production
PAYPAL_MODE=sandbox

# PayPal REST API Client ID (from Sandbox app)
PAYPAL_CLIENT_ID=PAYPAL_SANDBOX_CLIENT_ID_PLACEHOLDER

# PayPal REST API Client Secret (from Sandbox app — keep secret!)
PAYPAL_CLIENT_SECRET=PAYPAL_SANDBOX_CLIENT_SECRET_PLACEHOLDER

# PayPal Webhook ID (from Sandbox → Webhooks → your endpoint)
PAYPAL_WEBHOOK_ID=PAYPAL_WEBHOOK_ID_PLACEHOLDER

# Base URL for this backend (used in PayPal return/cancel URLs)
APP_BASE_URL=http://localhost:8000

# ──────────────────────────────────────────────
# AI / LLM Integration (optional)
# ──────────────────────────────────────────────

# Set to "gemini", "openai", or leave blank to use the deterministic engine
AI_PROVIDER=

# Google Gemini API key (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Email / SMTP (optional — simulated by default)
# ──────────────────────────────────────────────

# Set to "true" to send real emails via SMTP
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@paypilot.ai

# ──────────────────────────────────────────────
# CORS (Frontend URL)
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────────
# Development flags
# ──────────────────────────────────────────────

# Set to "true" to seed demo data on startup
SEED_DEMO_DATA=true

# Set to "true" to enable verbose SQL logging
DEBUG_SQL=false
